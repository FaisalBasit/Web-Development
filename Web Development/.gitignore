# ============================================================
# UNIVERSAL .gitignore
# Suitable for: Node.js, Next.js, React, Python, FastAPI,
# Django, Java, Go, Rust, PHP, Docker, databases, IDEs, etc.
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local environment variants
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret/config files
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# SSH / credentials
.ssh/
id_rsa
id_rsa.pub
id_dsa
id_ecdsa
id_ed25519
id_ed25519.pub

# Cloud/service credentials
credentials.json
client_secret.json
service-account.json
serviceAccount.json
google-credentials.json
gcloud-credentials.json

# Firebase
firebase-debug.log
.firebase/
.firebaserc.local

# Terraform secrets/state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# NOTE:
# If your project intentionally commits encrypted secrets,
# explicitly force-add them or adjust these rules.


